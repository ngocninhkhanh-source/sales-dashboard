# ════════════════════════════════════════════════════════════════════
# MẪU CẤU HÌNH BÍ MẬT — dán toàn bộ (sau khi điền) vào ô "Secrets" trên
# Streamlit Community Cloud, hoặc lưu thành `.streamlit/secrets.toml` để chạy local.
# TUYỆT ĐỐI KHÔNG commit file secrets.toml thật lên GitHub.
# Phần nào chưa dùng → xoá cả phần → dashboard ghi "Chưa cấu hình".
# ════════════════════════════════════════════════════════════════════

# Mật khẩu vào dashboard (xoá dòng này nếu không cần). Phải nằm TRÊN CÙNG.
app_password = "doi-mat-khau-nay"

# ── Danh sách Sale: mỗi người một khối [[sales]] ────────────────────
# email         : email Google của Sale (lịch + hộp thư gửi recap)
# bitrix_id     : số cuối URL trang cá nhân Bitrix24 (.../company/personal/user/5/)
# voicecloud_id : máy nhánh / username tổng đài, trùng giá trị API VoiceCloud trả về
[[sales]]
name = "Nguyễn Minh Anh"
email = "anh@congty.vn"
bitrix_id = "5"
voicecloud_id = "101"

[[sales]]
name = "Trần Quốc Bảo"
email = "bao@congty.vn"
bitrix_id = "7"
voicecloud_id = "102"

# ── Google Service Account (dùng cho Calendar + Gmail) ──────────────
# Dán kết quả lệnh chuyển đổi file JSON vào đây (xem hướng dẫn bước 9).
[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "xxxxxxxxxxxxxxxxxxxxxxxx"
private_key = "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
client_email = "dashboard@your-project-id.iam.gserviceaccount.com"
client_id = "123456789012345678901"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/dashboard%40your-project-id.iam.gserviceaccount.com"
universe_domain = "googleapis.com"

# ── Bitrix24 (Inbound webhook, quyền CRM) ───────────────────────────
[bitrix24]
webhook_url = "https://congty.bitrix24.vn/rest/1/abcdef123456/"
# Các cột của bảng "Lead tồn theo stage" — gõ ĐÚNG tên stage như trên Bitrix24
lead_stages = ["New", "Call 1", "Call 2", "Call 3", "Qualify", "UnQLF"]
# Stage không tính vào "Lead tồn" (lead đã loại)
lead_closed_stages = ["UnQLF"]
# deal_category_id = "0"   # (tuỳ chọn) chỉ lấy 1 pipeline cho Deal / Doanh thu

# ── Google Calendar: đếm meeting ────────────────────────────────────
[google_calendar]
domain_wide_delegation = true        # true: Workspace + delegation | false: Sale tự share lịch
internal_domains = ["congty.vn"]     # chỉ tính meeting có khách ngoài các tên miền này
min_attendees = 2
title_keywords = []                  # vd ["demo", "gặp"] — [] = không lọc theo tiêu đề

# ── Gmail: kiểm tra recap cho TỪNG meeting (bắt buộc Workspace + delegation) ──
[gmail]
recap_window_hours = 48              # recap phải gửi trong 48 giờ sau khi meeting kết thúc
subject_keywords = []                # [] = mọi email gửi tới khách đều tính là recap
                                     # ["recap"] = bắt buộc tiêu đề chứa chữ "recap"

# ── VoiceCloud: lịch sử cuộc gọi ────────────────────────────────────
[voicecloud]
base_url = "https://portal.voicecloud.vn"
endpoint = "/api/v1/call-history"
method = "GET"
auth_header = "Authorization"
auth_value = "Bearer YOUR_API_TOKEN"
date_format = "%Y-%m-%d %H:%M:%S"
param_from = "from_date"
param_to = "to_date"
param_page = "page"
param_page_size = "limit"
page_size = 500
first_page = 1
records_path = "data"
field_agent = "extension"
field_start = "start_time"
field_duration = "duration"
# field_direction = "direction"      # (tuỳ chọn) chỉ đếm cuộc gọi ra
# outbound_value = "outbound"
